<!DOCTYPE html>
<html prefix="og: http://ogp.me/ns#" data-theme="light">
  <head>
    <%= render 'shared/meta_info' %>
    <title>
      <%= title %>
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>
  <body>
    <!-- Modern Bootstrap 5 Navbar -->
    <nav class="navbar navbar-expand-lg navbar-light fixed-top">
      <div class="container-fluid">
        <%= link_to '/', class: "navbar-brand d-flex align-items-center" do %>
          <%= image_tag 'rusrails.png', alt: 'RusRails', class: 'me-2' %>
        <% end %>

        <!-- Mobile menu button -->
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Navigation items -->
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav ms-auto">
            <li class="nav-item">
              <%= link_to 'Главная', '/', class: "nav-link" %>
            </li>

            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                Содержание
              </a>
              <div class="dropdown-menu dropdown-menu-end p-3" aria-labelledby="navbarDropdown" style="min-width: 600px;">
                <% menu_page = Page.matched("menu") %>
                <% cache ['v2', menu_page] do %>
                  <%= menu_page.rendered_body(self) %>
                <% end %>
              </div>
            </li>

            <li class="nav-item">
              <%= link_to 'Поиск', '/search', class: "nav-link" %>
            </li>

            <li class="nav-item">
              <%= link_to 'Ruby & Rails API', 'http://api.rusrails.ru', target: :blank, class: "nav-link" %>
            </li>

            <!-- Dark mode toggle -->
            <li class="nav-item">
              <button id="theme-toggle" class="btn theme-toggle ms-2" aria-label="Toggle dark mode">
                <i class="fas fa-moon"></i>
              </button>
            </li>
          </ul>
        </div>
      </div>
    </nav>
    <!-- Flash messages with modern Bootstrap alerts -->
    <% if notice %>
      <div class="alert alert-success alert-dismissible fade show m-3" role="alert">
        <%= notice %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% end %>
    <% if alert %>
      <div class="alert alert-danger alert-dismissible fade show m-3" role="alert">
        <%= alert %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% end %>

    <!-- Main content wrapper -->
    <main class="content-wrapper">
      <div class="container-fluid">
        <div class="row">
          <!-- Sidebar -->
          <div class="col-lg-3 col-md-4 order-md-2">
            <!-- Social/GitHub section -->
            <div class="sidebar">
              <h4>Принимаем пожелания и пул-реквесты!</h4>
              <div class="d-flex align-items-center justify-content-center">
                <%= link_to 'https://github.com/rusrails/rusrails', target: :blank, class: "btn btn-outline-dark d-flex align-items-center" do %>
                  <i class="fab fa-github me-2"></i>
                  Star on GitHub
                <% end %>
              </div>
            </div>

            <!-- Dynamic menu section -->
            <% if content_for?(:menu) %>
              <div class="sidebar">
                <%= yield(:menu) %>
              </div>
            <% end %>

            <!-- Ad space -->
            <div class="sidebar text-center">
              <%= render "shared/adsense", position: 'sidebar' %>
            </div>
          </div>

          <!-- Main content -->
          <div class="col-lg-9 col-md-8 order-md-1">
            <!-- Top banner -->
            <div class="text-center mb-3">
              <%= render "shared/adsense", position: 'top' %>
            </div>

            <!-- Page content -->
            <div class="main-content">
              <%= yield %>
            </div>

            <!-- Bottom banner -->
            <div class="text-center mt-4">
              <%= render "shared/adsense", position: 'bottom' %>
            </div>
          </div>
        </div>
      </div>
    </main>

    <!-- Modern footer -->
    <footer class="footer">
      <div class="container-fluid">
        <div class="row">
          <div class="col-12">
            <p>
              <%= link_to 'https://github.com/rusrails/rusrails', target: :blank, class: "text-decoration-none" do %>
                <i class="fab fa-github fa-2x"></i>
              <% end %>
            </p>
            <p>
              <%= link_to "Лицензия CC BY-SA 4.0", "https://creativecommons.org/licenses/by-sa/4.0/", class: "text-decoration-none" %>
              <br>
              "Rails", "Ruby on Rails" и логотип Rails - торговые марки DHH
            </p>
            <%= render "layouts/counter" %>
          </div>
        </div>
      </div>
    </footer>

    <!-- Scroll to top button (created by JavaScript) -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>
    <%= javascript_include_tag "application", "data-turbo-track": "reload" %>
  </body>
</html>

